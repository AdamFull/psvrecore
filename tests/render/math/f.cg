// Transcendentals and vector math per pixel.
float4 main(float2 vTexCoord : TEXCOORD0) : COLOR
{
    float2 p = vTexCoord * 6.0 - 3.0;
    float3 n = normalize(float3(p, 1.5));
    float r = 0.5 + 0.5 * sin(p.x * 1.7) * cos(p.y * 1.3);
    float g = exp2(-dot(p, p) * 0.2) + 0.1 * log2(1.0 + abs(p.x));
    float b = pow(saturate(n.z), 3.0) * rsqrt(1.0 + abs(p.y));
    return float4(r, g, b, 1.0);
}
